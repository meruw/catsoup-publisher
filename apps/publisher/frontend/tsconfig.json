{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "isolatedModules": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM"], "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "bindings/**/*.ts"]
}
